{
  "name": "payment-idempotency-gateway",
  "version": "1.0.0",
  "description": "Portfolio project demonstrating distributed-systems payment idempotency",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:provider": "tsx watch provider/app.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "worker:reconciliation": "tsx src/workers/uncertain-payment-recovery.ts",
    "migrate:latest": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:make": "knex migrate:make",
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "keywords": [
    "payment",
    "idempotency",
    "distributed-systems",
    "portfolio"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@types/redis": "^4.0.10",
    "fastify": "^4.26.1",
    "fastify-raw-body": "^4.3.0",
    "ioredis": "^6.0.0",
    "knex": "^3.1.0",
    "pg": "^8.11.3",
    "pino": "^8.19.0",
    "pino-pretty": "^10.3.1",
    "redis": "^6.2.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "@types/pg": "^8.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "eslint": "^8.56.0",
    "prettier": "^3.2.5",
    "supertest": "^6.3.4",
    "testcontainers": "^10.7.1",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.2"
  }
}
